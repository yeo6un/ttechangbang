{
  "name": "ttechangbang",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "떼창방 — 친구들과 파트를 나눠 부르는 웹 커버 스튜디오",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/node-server.mjs",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run --config web/vite.config.ts",
    "test:api": "node tests/api.test.mjs",
    "test:e2e": "node tests/e2e.mjs && node tests/e2e-create.mjs && node tests/e2e-ai.mjs",
    "cf:dev": "wrangler dev -c wrangler.local.jsonc",
    "deploy": "wrangler deploy"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@fontsource/black-han-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "wasm-media-encoders": "^0.7.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.56.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "cloudflare": {
    "label": "떼창방",
    "products": [
      "Workers",
      "D1",
      "Workers AI"
    ],
    "bindings": {
      "DB": {
        "description": "방과 녹음을 저장하는 데이터베이스입니다. 이름은 그대로 두어도 됩니다."
      },
      "AI": {
        "description": "가사 자동 싱크와 파트 추천에 쓰는 Workers AI 입니다 (무료 할당량 안에서 동작)."
      }
    }
  }
}
